# ==================== 阿里云百炼（LLM + 语音统一 Key） ====================
# 控制台: https://bailian.console.aliyun.com → API-KEY
# 说明: 该 Key 同时用于 ASR/TTS（dashscope SDK 复用），配置一个即可跑通全链路
ALIYUN_BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_PROVIDER=aliyun              # aliyun | deepseek
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== Deepseek LLM（备选） ====================
# 设置 LLM_PROVIDER=deepseek 后生效
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ==================== ASR / TTS（可选独立 token，默认复用百炼 Key） ====================
# 控制台: https://bailian.console.aliyun.com（模型广场 → 语音合成/语音识别）
ALIYUN_ASR_TOKEN=
ALIYUN_TTS_TOKEN=
ALIYUN_ASR_MODEL=paraformer-v2
ALIYUN_TTS_MODEL=sambert-zhichu-v1
ALIYUN_TTS_VOICE=ailiao

# ==================== 高德地图（服务端 REST，地图/天气/路线工具） ====================
# 控制台: https://console.amap.com → 应用管理 → 创建「Web服务」类型 Key
AMAP_SERVER_API_KEY=your_amap_server_key

# ==================== 腾讯位置服务（小程序 map 组件，可选） ====================
# 控制台: https://lbs.qq.com → 应用管理
TENCENT_LBS_KEY=your_tencent_lbs_key

# ==================== 服务配置 ====================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=1
DB_PATH=./data/voice.db
MAX_TOOL_ROUNDS=5
REQUEST_TIMEOUT=10
RATE_LIMIT_PER_MIN=60
MAX_INPUT_CHARS=2000
DEFAULT_CITY=北京
SYSTEM_PROMPT=
