# ==================== 阿里云百炼 LLM ====================
# 控制台: https://bailian.console.aliyun.com → API-KEY
ALIYUN_BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== Deepseek LLM（备选） ====================
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# ==================== 阿里云智能语音 ASR ====================
# 控制台: https://nls-portal.console.aliyun.com → 项目管理
ALIYUN_ASR_APP_KEY=your_asr_appkey
ALIYUN_ASR_TOKEN=your_asr_token
ALIYUN_ASR_WS_URL=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1

# ==================== 阿里云智能语音 TTS ====================
ALIYUN_TTS_APP_KEY=your_tts_appkey
ALIYUN_TTS_TOKEN=your_tts_token
ALIYUN_TTS_VOICE=ailiao
ALIYUN_TTS_WS_URL=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1

# ==================== 高德地图 ====================
# 控制台: https://console.amap.com → 应用管理
AMAP_JS_API_KEY=your_amap_js_key
AMAP_MCP_ENDPOINT=https://mcp.amap.com/sse
AMAP_MCP_TOKEN=your_amap_mcp_token

# ==================== 服务配置 ====================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
MAX_TOOL_ROUNDS=5
REQUEST_TIMEOUT=10
RATE_LIMIT_PER_MIN=60
