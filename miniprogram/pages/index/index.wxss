.page {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
}

/* ===== 自定义导航栏（玻璃质感） ===== */
.nav-bar {
  background: rgba(20, 24, 33, 0.6);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  position: relative;
  z-index: 10;
  flex-shrink: 0;
}

.nav-main {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-title-wrap {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.2;
}

.nav-sub {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 2rpx;
}

/* ===== 断网横幅 ===== */
.offline-banner {
  background: var(--danger);
  padding: 14rpx 32rpx;
  text-align: center;
}

.offline-text {
  color: #FFFFFF;
  font-size: 26rpx;
}

/* ===== 消息流 ===== */
.chat-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  position: relative;
}

.chat-inner {
  padding: 24rpx 32rpx 40rpx;
}

.tool-row {
  display: flex;
  margin-bottom: 36rpx;
  width: 100%;
}

.tool-row.right {
  justify-content: flex-end;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(91, 141, 239, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}

.empty-mic {
  width: 56rpx;
  height: 72rpx;
  border-radius: 28rpx;
  border: 6rpx solid var(--primary);
  opacity: 0.7;
  position: relative;
}

.empty-mic::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 14rpx;
  border: 6rpx solid var(--primary);
  border-top: none;
  border-left: none;
  border-right: none;
  border-radius: 0 0 14rpx 14rpx;
  bottom: -18rpx;
  left: 50%;
  margin-left: -16rpx;
}

.empty-title {
  font-size: 36rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 48rpx;
}

.suggest-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.suggest {
  background: var(--card-glass);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--bubble-ai-border);
}

.suggest text {
  font-size: 28rpx;
  color: var(--text-2);
}

/* ===== 底部输入栏：完全透明，悬浮在页面底部 ===== */
.input-bar {
  background: transparent;
  border-top: none;
  padding: 12rpx 24rpx calc(var(--safe-bottom) + 12rpx);
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 左侧输入方式切换图标（🎤 / ⌨） */
.mode-toggle {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 40rpx;
  background: var(--input-bg);
  border: 2rpx solid var(--btn-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mode-toggle:active {
  transform: scale(0.94);
}

.mode-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text);
  line-height: 1;
}

/* 语音模式：未录音「点击开始录音」 */
.rec-start {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--input-bg);
  border: 2rpx solid var(--btn-border);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  animation: pill-breathe 2.8s ease-in-out infinite;
}

.rec-start:active {
  transform: scale(0.985);
  border-color: rgba(91, 141, 239, 0.55);
  background: rgba(26, 30, 39, 0.7);
}

.rec-start.denied {
  animation: none;
  border-color: var(--danger);
}

.rec-start-txt {
  font-size: 30rpx;
  color: var(--text);
  letter-spacing: 0.5rpx;
}

/* 录音中：完成录音（主按钮）+ 取消（右侧）+ 计时 */
.rec-ing {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rec-finish {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--primary-grad);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(91, 141, 239, 0.28);
}

.rec-finish:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.rec-finish-txt {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.rec-cancel {
  height: 88rpx;
  padding: 0 36rpx;
  border-radius: 44rpx;
  background: var(--input-bg);
  border: 2rpx solid var(--btn-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rec-cancel:active {
  transform: scale(0.96);
  border-color: var(--danger);
}

.rec-cancel text {
  font-size: 30rpx;
  color: var(--text);
}

.rec-dur {
  font-size: 26rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  min-width: 96rpx;
  text-align: right;
}

@keyframes pill-breathe {
  0%, 100% { box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.30), 0 0 24rpx rgba(91, 141, 239, 0.06); }
  50% { box-shadow: 0 14rpx 48rpx rgba(0, 0, 0, 0.36), 0 0 40rpx rgba(91, 141, 239, 0.18); }
}

/* ===== 导航栏「清空」按钮 ===== */
.nav-actions {
  position: absolute;
  right: 196rpx;
  top: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.nav-clear {
  font-size: 28rpx;
  color: var(--text-2);
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.nav-clear:active {
  background: rgba(255, 82, 82, 0.16);
  border-color: var(--danger);
  color: var(--danger);
}

/* 文字输入 */
.text-input-row {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.text-input {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  background: var(--input-bg);
  border-radius: 44rpx;
  font-size: 30rpx;
  color: var(--text);
  border: 2rpx solid var(--btn-border);
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--text-2);
}

.send-btn {
  width: 120rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--input-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.5;
  border: 2rpx solid var(--btn-border);
}

.send-btn.active {
  background: var(--primary);
  opacity: 1;
}

.send-btn text {
  font-size: 28rpx;
  color: var(--text);
}

.send-btn.active text {
  color: #FFFFFF;
}

