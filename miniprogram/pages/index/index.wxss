.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-base);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.nav-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: var(--bg-glass);
  border-radius: var(--radius-sm);
}

.chat {
  flex: 1;
  padding: 24rpx 32rpx;
}

.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40vh;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.input-bar {
  padding: 24rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  display: flex;
  justify-content: center;
}

.mic-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--bg-glass);
  border: 1rpx solid var(--border-default);
  box-shadow: var(--shadow-glow);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}
