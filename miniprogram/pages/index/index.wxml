<!-- 主聊天页（骨架占位，业务实现待文档确认后开发） -->
<view class="page">
  <view class="nav">
    <view class="nav-title">灵语 · AI 语音助手</view>
    <view class="nav-actions">
      <view class="nav-icon" bindtap="goSettings">⚙</view>
    </view>
  </view>

  <scroll-view class="chat" scroll-y enable-flex>
    <view class="chat-empty">
      <view class="empty-title">开启你的第一次对话</view>
      <view class="empty-sub">按住下方按钮说话，或直接输入文字</view>
    </view>
  </scroll-view>

  <view class="input-bar">
    <view class="mic-btn">🎤</view>
  </view>
</view>
