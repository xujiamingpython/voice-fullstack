.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
  color: var(--text);
}

/* 导航栏 */
.nav-bar {
  background: var(--nav-bg);
}

.nav-main {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}

.new-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.new-plus {
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 1;
}

/* 列表 */
.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-inner {
  padding: 24rpx 32rpx 120rpx;
}

.convo-card {
  display: flex;
  align-items: center;
  background: var(--card-glass);
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid var(--bubble-ai-border);
  overflow: hidden;
}

.convo-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.convo-title {
  font-size: 32rpx;
  color: var(--text);
  margin-bottom: 8rpx;
}

.convo-time {
  font-size: 24rpx;
  color: var(--text-2);
}

.del-btn {
  width: 96rpx;
  height: 64rpx;
  background: var(--danger);
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 24rpx;
  flex-shrink: 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(91, 141, 239, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}

.empty-mic {
  width: 56rpx;
  height: 72rpx;
  border-radius: 28rpx;
  border: 6rpx solid var(--primary);
  opacity: 0.7;
}

.empty-title {
  font-size: 36rpx;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-2);
}
