<view class="page theme-{{theme}}">
  <!-- 自定义导航栏 -->
  <view class="nav-bar">
    <view class="nav-status" style="height: {{statusBarHeight}}px;"></view>
    <view class="nav-main">
      <text class="nav-title">会话历史</text>
      <view class="new-btn" bindtap="newSession">
        <text class="new-plus">＋</text>
      </view>
    </view>
  </view>

  <!-- 列表 -->
  <scroll-view class="list-scroll" scroll-y>
    <view class="list-inner">
      <block wx:for="{{conversations}}" wx:key="id">
        <view class="convo-card" bindlongpress="onLongPress" data-id="{{item.id}}" data-title="{{item.title}}">
          <view class="convo-main">
            <text class="convo-title ellipsis">{{item.title}}</text>
            <text class="convo-time">{{item.timeText}}</text>
          </view>
          <view class="del-btn" catchtap="onDelete" data-id="{{item.id}}">删除</view>
        </view>
      </block>

      <!-- 空状态 -->
      <view wx:if="{{!conversations.length}}" class="empty-state">
        <view class="empty-icon">
          <view class="empty-mic"></view>
        </view>
        <text class="empty-title">暂无历史记录</text>
        <text class="empty-sub">开启你的第一次对话</text>
      </view>
    </view>
  </scroll-view>
</view>
