.map-card {
  background: var(--card-glass);
  border-radius: 32rpx;
  overflow: hidden;
  width: 100%;
  margin: 8rpx 0 4rpx 0;
}

.map-wrap {
  height: 340rpx;
  background: var(--map-bg);
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

/* 加载态 */
.map-loading {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: dot-bounce 1.2s ease-in-out infinite;
}

.loading-dot.d2 { animation-delay: 0.15s; }
.loading-dot.d3 { animation-delay: 0.3s; }

@keyframes dot-bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-10rpx); opacity: 1; }
}

/* 摘要条 */
.map-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
}

.map-summary {
  font-size: 28rpx;
  color: var(--text);
}

.view-all {
  font-size: 26rpx;
  color: var(--primary);
  flex-shrink: 0;
}
