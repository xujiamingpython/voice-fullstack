.tool-card {
  background: var(--card-glass);
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  margin: 8rpx 0 4rpx 0;
  width: 100%;
}

/* ===== 标题栏 ===== */
.tool-head {
  display: flex;
  align-items: center;
}

.tool-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: rgba(91, 141, 239, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.tool-icon-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 3rpx solid var(--primary);
  position: relative;
}

.tool-icon-dot::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 12rpx;
  background: var(--primary);
  bottom: -12rpx;
  left: 50%;
  margin-left: -2rpx;
  border-radius: 2rpx;
}

.tool-name {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
  flex: 1;
}

.tool-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tool-status-text {
  font-size: 24rpx;
  color: var(--text-2);
}

.tool-arrow {
  font-size: 24rpx;
  color: var(--text-2);
}

/* ===== 代码块 ===== */
.code-block {
  background: var(--code-bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 20rpx;
  position: relative;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.code-pulse {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--text-2);
  margin-top: 10rpx;
  flex-shrink: 0;
}

.code-pulse.on {
  background: #FFD04A;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}

.code-text {
  font-size: 24rpx;
  color: var(--text);
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.5;
}

/* ===== 底部状态 ===== */
.tool-foot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.status-light {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-light.green { background: var(--accent-cyan); box-shadow: 0 0 12rpx var(--accent-cyan); }
.status-light.red { background: var(--danger); box-shadow: 0 0 12rpx var(--danger); }

.foot-text {
  font-size: 26rpx;
  color: var(--text-2);
}

.tool-foot.done .foot-text {
  color: var(--text);
}

.tool-foot.fail {
  animation: shake 0.4s ease;
}

/* ===== 摘要 + 打开地图 ===== */
.tool-summary {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--divider);
}

.summary-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-2);
}

.open-map {
  font-size: 26rpx;
  color: var(--primary);
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--primary);
  border-radius: 16rpx;
  flex-shrink: 0;
}

/* ===== 失败抖动 ===== */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-8rpx); }
  40% { transform: translateX(8rpx); }
  60% { transform: translateX(-6rpx); }
  80% { transform: translateX(6rpx); }
}
