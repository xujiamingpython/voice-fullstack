.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 36rpx;
  max-width: 100%;
}

.msg-row.user {
  justify-content: flex-end;
}

/* ===== 头像 ===== */
.avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1B2A4A, #24325A);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  margin-top: 8rpx;
}

.avatar-wave {
  width: 24rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid var(--primary);
  border-left-color: transparent;
  transform: rotate(0deg);
  position: relative;
}

/* ===== 主体 ===== */
.msg-main {
  max-width: 78%;
  display: flex;
  flex-direction: column;
}

.msg-main.user {
  align-items: flex-end;
}

.msg-main.ai {
  align-items: flex-start;
}

/* ===== 气泡 ===== */
.bubble {
  border-radius: 32rpx;
  padding: 22rpx 28rpx;
  word-break: break-all;
}

.bubble-user {
  background: var(--bubble-user);
  border-bottom-right-radius: 12rpx;
}

.msg-text-user {
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 1.5;
}

.bubble-ai {
  background: var(--bubble-ai);
  border: 2rpx solid var(--bubble-ai-border);
  border-bottom-left-radius: 12rpx;
}

.msg-text-ai {
  color: var(--text);
  font-size: 32rpx;
  line-height: 1.55;
}

.bubble-error {
  background: rgba(255, 82, 82, 0.12);
  border: 2rpx solid rgba(255, 82, 82, 0.35);
}

.msg-text-error {
  color: var(--danger);
  font-size: 30rpx;
}

/* ===== 思考中 ===== */
.bubble-thinking {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 26rpx 32rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: dot-bounce 1.2s ease-in-out infinite;
}

.d2 { animation-delay: 0.15s; }
.d3 { animation-delay: 0.3s; }

@keyframes dot-bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-10rpx); opacity: 1; }
}

.thinking-text {
  font-size: 28rpx;
  color: var(--text-2);
  margin-left: 8rpx;
}

.thinking-wait {
  font-size: 24rpx;
  color: var(--text-2);
  opacity: 0.7;
  margin-left: 12rpx;
}

/* ===== AI 操作按钮 ===== */
.msg-actions {
  display: flex;
  gap: 28rpx;
  margin-top: 12rpx;
  padding-left: 8rpx;
}

.action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.action-icon {
  font-size: 26rpx;
  line-height: 1;
}

.action-active {
  color: var(--primary);
}
