<!-- 纯展示：手势已由页面级 .rec-gesture-layer 处理，这里不再挂载任何 touch 事件 -->
<view class="mic-wrap">

  <!-- 录音中：明确的操作提示（位于胶囊上方），告知如何取消 / 发送 -->
  <view wx:if="{{status === 'recording'}}" class="rec-hint {{cancelHint ? 'danger' : ''}}">
    <text class="rec-arrow">{{cancelHint ? '↧' : '↑'}}</text>
    <text class="rec-hint-text">{{cancelHint ? '松手取消发送' : (swipeHint ? '继续上滑取消' : '松开发送 · 上滑可取消')}}</text>
  </view>

  <!-- 悬浮胶囊按钮 -->
  <view class="mic-btn {{status}} {{cancelHint ? 'cancelling' : ''}}">
    <view wx:if="{{status !== 'recognizing'}}" class="mic-icon {{status}} {{cancelHint ? 'cancelling' : ''}}">
      <view class="mic-body"></view>
      <view class="mic-arc"></view>
    </view>

    <!-- 识别中 spinner -->
    <view wx:if="{{status === 'recognizing'}}" class="spinner-ring"></view>
    <view wx:if="{{status === 'recognizing'}}" class="spinner-mask"></view>

    <text class="btn-text {{status}} {{cancelHint ? 'cancelling' : ''}}">
      <block wx:if="{{status === 'idle'}}">按住说话</block>
      <block wx:elif="{{status === 'pressing'}}">松开发送</block>
      <block wx:elif="{{status === 'recording'}}">{{cancelHint ? '松开取消' : durationText}}</block>
      <block wx:elif="{{status === 'recognizing'}}">识别中…</block>
      <block wx:elif="{{status === 'failed'}}">未识别，请重试</block>
      <block wx:elif="{{status === 'denied'}}">需要麦克风权限</block>
    </text>

    <text wx:if="{{status === 'denied'}}" class="go-open" catchtap="_goOpen">去开启</text>
  </view>
</view>
