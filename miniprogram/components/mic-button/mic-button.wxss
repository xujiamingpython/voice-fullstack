.mic-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 140rpx;
  position: relative;
  z-index: 10;
  user-select: none;
  -webkit-user-select: none;
}

/* ===== 录音操作提示（胶囊上方，明确告知如何取消/发送） ===== */
.rec-hint {
  position: absolute;
  top: -58rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(26, 30, 39, 0.85);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  white-space: nowrap;
  pointer-events: none;
  animation: hint-pop 0.18s ease;
}

@keyframes hint-pop {
  0% { opacity: 0; transform: translateX(-50%) translateY(8rpx); }
  100% { opacity: 1; transform: translateX(-50%) translateY(0); }
}

.rec-arrow {
  font-size: 30rpx;
  color: var(--text-2);
  line-height: 1;
}

.rec-hint-text {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1;
}

.rec-hint.danger {
  background: rgba(255, 82, 82, 0.16);
  border-color: var(--danger);
}

.rec-hint.danger .rec-arrow,
.rec-hint.danger .rec-hint-text {
  color: var(--danger);
  font-weight: 500;
}

/* ===== 悬浮胶囊按钮（参考支付宝「按住说话」药丸） ===== */
.mic-btn {
  width: 620rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: rgba(26, 30, 39, 0.45);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  position: relative;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.35), 0 0 0 1rpx rgba(255, 255, 255, 0.04);
  transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease, border-color 0.12s ease;
}

/* 待机态：柔和呼吸光晕 */
.mic-btn.idle {
  animation: pill-breathe 2.8s ease-in-out infinite;
}

@keyframes pill-breathe {
  0%, 100% { box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.35), 0 0 28rpx rgba(91, 141, 239, 0.08); border-color: rgba(255, 255, 255, 0.10); }
  50% { box-shadow: 0 14rpx 48rpx rgba(0, 0, 0, 0.40), 0 0 44rpx rgba(91, 141, 239, 0.20); border-color: rgba(255, 255, 255, 0.18); }
}

.mic-btn.pressing {
  transform: scale(0.97);
  background: rgba(26, 30, 39, 0.65);
  border-color: rgba(91, 141, 239, 0.55);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35), 0 0 32rpx rgba(91, 141, 239, 0.22);
}

.mic-btn.recording {
  background: linear-gradient(135deg, rgba(91, 141, 239, 0.95) 0%, rgba(124, 91, 239, 0.95) 100%);
  border-color: rgba(255, 255, 255, 0.22);
  box-shadow: 0 14rpx 48rpx rgba(0, 0, 0, 0.42), 0 0 60rpx rgba(91, 141, 239, 0.28);
}

.mic-btn.cancelling {
  background: rgba(26, 30, 39, 0.55);
  border-color: var(--danger);
  transform: scale(0.95);
  opacity: 0.85;
}

.mic-btn.recognizing {
  background: rgba(26, 30, 39, 0.55);
}

.mic-btn.failed {
  background: var(--danger);
  border-color: transparent;
  animation: shake 0.4s ease;
}

.mic-btn.denied {
  background: rgba(26, 30, 39, 0.35);
  opacity: 0.55;
}

/* ===== 胶囊内文字 ===== */
.btn-text {
  font-size: 30rpx;
  color: var(--text);
  line-height: 1;
  letter-spacing: 0.5rpx;
  max-width: 480rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.btn-text.recording,
.btn-text.cancelling {
  color: #FFFFFF;
}

.btn-text.failed {
  color: #FFFFFF;
}

/* ===== 小麦克风图标 ===== */
.mic-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  position: relative;
  transform: scale(0.9);
}

.mic-body {
  width: 22rpx;
  height: 28rpx;
  border-radius: 11rpx;
  border: 3rpx solid var(--text);
}

.mic-arc {
  width: 12rpx;
  height: 6rpx;
  border: 3rpx solid var(--text);
  border-top: none;
  border-left: none;
  border-right: none;
  border-radius: 0 0 8rpx 8rpx;
  margin-top: 2rpx;
}

/* 录音中 / 取消态图标变白 / 变红 */
.mic-icon.recording .mic-body,
.mic-icon.recording .mic-arc {
  border-color: #FFFFFF;
}

.mic-icon.cancelling .mic-body,
.mic-icon.cancelling .mic-arc {
  border-color: var(--danger);
}

/* ===== 识别中：旋转圆环 ===== */
.spinner-ring {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  border-top-color: var(--primary);
  border-right-color: var(--primary);
  animation: spin 0.8s linear infinite;
}

.spinner-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: transparent;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ===== 去开启 ===== */
.go-open {
  font-size: 26rpx;
  color: var(--primary);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(91, 141, 239, 0.12);
  margin-left: 12rpx;
}

/* ===== 失败抖动 ===== */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-12rpx); }
  40% { transform: translateX(12rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}
