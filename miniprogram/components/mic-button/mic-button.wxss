.mic-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 340rpx;
  position: relative;
  z-index: 10;
  user-select: none;
  -webkit-user-select: none;
}

/* 玻璃覆盖层：录音态显示，全屏毛玻璃，不抢触摸 */
.rec-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 17, 21, 0.5);
  -webkit-backdrop-filter: blur(24px);
  backdrop-filter: blur(24px);
  pointer-events: none;
  z-index: 0;
  user-select: none;
  -webkit-user-select: none;
}

/* ===== 中心按钮 ===== */
.mic-btn {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: var(--input-bg);
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow:
    0 12rpx 40rpx rgba(0, 0, 0, 0.35),
    0 0 60rpx rgba(91, 141, 239, 0.22),
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.12);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

/* 待机呼吸光晕 */
.mic-btn.idle {
  animation: breathe 2.8s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { box-shadow: 0 0 24rpx rgba(91, 141, 239, 0.12); }
  50% { box-shadow: 0 0 56rpx rgba(91, 141, 239, 0.32); }
}

.mic-btn.pressing {
  transform: scale(0.96);
  box-shadow:
    0 8rpx 28rpx rgba(0, 0, 0, 0.3),
    0 0 48rpx rgba(91, 141, 239, 0.35),
    inset 0 4rpx 12rpx rgba(0, 0, 0, 0.25);
  border-color: rgba(91, 141, 239, 0.6);
}

.mic-btn.recording {
  background: linear-gradient(135deg, rgba(91, 141, 239, 0.95) 0%, rgba(124, 91, 239, 0.95) 100%);
  border-color: rgba(255, 255, 255, 0.22);
  transform: scale(1.05);
  box-shadow:
    0 16rpx 56rpx rgba(0, 0, 0, 0.38),
    0 0 80rpx rgba(91, 141, 239, 0.32),
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.18);
}

.mic-btn.cancelling {
  background: var(--card);
  border-color: var(--danger);
  opacity: 0.6;
  transform: scale(0.92);
}

.mic-wrap.cancelling .mic-icon .mic-body,
.mic-wrap.cancelling .mic-icon .mic-arc {
  border-color: var(--danger);
}

.mic-btn.recognizing {
  background: var(--card);
}

.mic-btn.failed {
  background: var(--danger);
  border-color: transparent;
  animation: shake 0.4s ease;
}

.mic-btn.denied {
  background: var(--card);
  opacity: 0.45;
}

/* ===== 麦克风图形 ===== */
.mic-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mic-body {
  width: 40rpx;
  height: 52rpx;
  border-radius: 20rpx;
  border: 4rpx solid var(--text);
}

.mic-arc {
  width: 20rpx;
  height: 10rpx;
  border: 4rpx solid var(--text);
  border-top: none;
  border-left: none;
  border-right: none;
  border-radius: 0 0 12rpx 12rpx;
  margin-top: 6rpx;
}

/* 录音中图标变白 */
.mic-icon.recording .mic-body,
.mic-icon.recording .mic-arc {
  border-color: #FFFFFF;
}

/* ===== 识别中：旋转圆环 ===== */
.spinner-ring {
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid transparent;
  border-top-color: var(--primary);
  border-right-color: var(--primary);
  animation: spin 0.8s linear infinite;
}

.spinner-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--card);
}

/* 盖住麦克风图标显示圆环 */
.spinner-mask {
  background: transparent;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ===== 扩散波纹 ===== */
.ripple {
  position: absolute;
  width: 128rpx;
  height: 128rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.ripple-item {
  position: absolute;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 3rpx solid var(--primary);
  opacity: 0;
}

.r1 { animation: ripple 2.2s ease-out infinite; }
.r2 { animation: ripple 2.2s ease-out 0.7s infinite; }
.r3 { animation: ripple 2.2s ease-out 1.4s infinite; }

@keyframes ripple {
  0% { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(2.6); opacity: 0; }
}

/* ===== 音量柱 ===== */
.vbar-row {
  position: absolute;
  top: calc(50% - 140rpx);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 80rpx;
}

.vbar {
  width: 10rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #5B8DEF 0%, #7C5BEF 100%);
  transition: height 0.12s ease;
}

/* ===== 状态文字 ===== */
.status-line {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.status-text {
  font-size: 26rpx;
  color: var(--text-2);
}

.status-recording {
  color: var(--text);
}

.status-hint {
  color: #FFD600;
}

.status-danger {
  color: var(--danger);
}

.cancel-hint {
  font-size: 24rpx;
  color: var(--text-2);
}

.hint-active {
  color: #FFD600;
}

.go-open {
  font-size: 26rpx;
  color: var(--primary);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(91, 141, 239, 0.12);
}

/* ===== 失败抖动 ===== */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-12rpx); }
  40% { transform: translateX(12rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}
