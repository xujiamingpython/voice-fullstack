.mic-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 340rpx;
  position: relative;
  user-select: none;
  -webkit-user-select: none;
}

/* ===== 中心按钮 ===== */
.mic-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--input-bg);
  border: 2rpx solid var(--btn-border);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 0 40rpx rgba(91, 141, 239, 0.18);
  transition: transform 0.08s ease;
}

/* 待机呼吸光晕 */
.mic-btn.idle {
  animation: breathe 2.8s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { box-shadow: 0 0 24rpx rgba(91, 141, 239, 0.12); }
  50% { box-shadow: 0 0 56rpx rgba(91, 141, 239, 0.32); }
}

.mic-btn.pressing {
  transform: scale(0.95);
  box-shadow: inset 0 4rpx 12rpx rgba(0, 0, 0, 0.35), 0 0 40rpx rgba(91, 141, 239, 0.4);
  border-color: var(--primary);
}

.mic-btn.recording {
  background: linear-gradient(135deg, #5B8DEF 0%, #7C5BEF 100%);
  border-color: transparent;
  transform: scale(1.02);
}

.mic-btn.recognizing {
  background: var(--card);
}

.mic-btn.failed {
  background: var(--danger);
  border-color: transparent;
  animation: shake 0.4s ease;
}

.mic-btn.denied {
  background: var(--card);
  opacity: 0.45;
}

/* ===== 麦克风图形 ===== */
.mic-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mic-body {
  width: 40rpx;
  height: 52rpx;
  border-radius: 20rpx;
  border: 4rpx solid var(--text);
}

.mic-arc {
  width: 20rpx;
  height: 10rpx;
  border: 4rpx solid var(--text);
  border-top: none;
  border-left: none;
  border-right: none;
  border-radius: 0 0 12rpx 12rpx;
  margin-top: 6rpx;
}

/* 录音中图标变白 */
.mic-icon.recording .mic-body,
.mic-icon.recording .mic-arc {
  border-color: #FFFFFF;
}

/* ===== 识别中：旋转圆环 ===== */
.spinner-ring {
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid transparent;
  border-top-color: var(--primary);
  border-right-color: var(--primary);
  animation: spin 0.8s linear infinite;
}

.spinner-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--card);
}

/* 盖住麦克风图标显示圆环 */
.spinner-mask {
  background: transparent;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ===== 扩散波纹 ===== */
.ripple {
  position: absolute;
  width: 128rpx;
  height: 128rpx;
  top: 0;
  left: 50%;
  margin-left: -64rpx;
}

.ripple-item {
  position: absolute;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 3rpx solid var(--primary);
  opacity: 0;
}

.r1 { animation: ripple 2.2s ease-out infinite; }
.r2 { animation: ripple 2.2s ease-out 0.7s infinite; }
.r3 { animation: ripple 2.2s ease-out 1.4s infinite; }

@keyframes ripple {
  0% { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(2.6); opacity: 0; }
}

/* ===== 音量柱 ===== */
.vbar-row {
  position: absolute;
  top: -110rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 80rpx;
}

.vbar {
  width: 10rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #5B8DEF 0%, #7C5BEF 100%);
  transition: height 0.12s ease;
}

/* ===== 状态文字 ===== */
.status-line {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.status-text {
  font-size: 26rpx;
  color: var(--text-2);
}

.status-recording {
  color: var(--text);
}

.status-danger {
  color: var(--danger);
}

.cancel-hint {
  font-size: 24rpx;
  color: var(--text-2);
}

.go-open {
  font-size: 26rpx;
  color: var(--primary);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(91, 141, 239, 0.12);
}

/* ===== 失败抖动 ===== */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-12rpx); }
  40% { transform: translateX(12rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}
